# Régression des arguments : codes de sortie exacts, y compris en Release.
if(NOT DEFINED PLPT_MONITOR)
  message(FATAL_ERROR "PLPT_MONITOR required")
endif()
function(run_case name code pattern)
  execute_process(COMMAND "${PLPT_MONITOR}" ${ARGN}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
  if(NOT "${result}" STREQUAL "${code}" OR NOT "${output}${errors}" MATCHES "${pattern}")
    message(FATAL_ERROR "${name}: expected exit ${code} / ${pattern}, got ${result}\n${output}${errors}")
  endif()
  if("${output}${errors}" MATCHES "AddressSanitizer|LeakSanitizer|UndefinedBehaviorSanitizer|runtime error:")
    message(FATAL_ERROR "${name}: sanitizer diagnostic\n${output}${errors}")
  endif()
  message(STATUS "PASS ${name}: exit ${result}")
endfunction()
run_case(help 0 "no probes, no server, no sharing" --help)
run_case(version 0 "no sharing" --version)
run_case(unknown 2 "Usage:" --not-a-plpt-option)
run_case(extra-argument 2 "Usage:" --version extra)
run_case(ambiguous 2 "Usage:" --help --version)
